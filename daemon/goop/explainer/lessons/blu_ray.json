  "steps": [
    {"say": "A Blu-ray disc looks like a shiny mirror, but it hides millions of tiny bumps and flat spots. Let's see how a player reads them!",
     "do": [{"reveal": ["motor", "disc"]}, {"label": ["disc"]}, {"zoom": "all"}]},
    {"say": "The disc sits on a spindle motor that spins it round and round, faster than a spinning top.",

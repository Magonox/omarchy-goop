{
  "manifest_version": 3,
  "name": "Goop page reader",
  "version": "1.0",
  "description": "Lets Goop read the text of the page you are looking at, only when you ask it a question. Nothing is stored or sent anywhere except to Goop on this computer.",
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file:///*"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "incognito": "not_allowed"
}
